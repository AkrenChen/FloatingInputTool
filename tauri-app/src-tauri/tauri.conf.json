{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FloatingInputTool",
  "version": "0.2.0",
  "identifier": "com.jolynea.floatinginputtool",
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "chenyb",
    "copyright": "Copyright (c) 2026 chenyb. Xiaohongshu @\u843d\u96e8\u8fd4\u5c4b\u4f01 (210601284kk). All rights reserved.",
    "category": "Utility",
    "shortDescription": "A lightweight floating capture tool for fleeting markdown notes.",
    "longDescription": "FloatingInputTool is a Windows tray utility for quickly capturing fleeting notes into configurable Markdown files.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FloatingInputTool",
        "width": 560,
        "height": 360,
        "minWidth": 520,
        "minHeight": 320,
        "visible": false,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
